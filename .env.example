APP_NAME=Autonomous Contract Scope Evaluator
APP_ENV=development

API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api

FRONTEND_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=acse_db

JWT_SECRET_KEY=replace_with_secure_secret
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=480

LLM_API_URL=http://122.163.121.177:3041/api/generate
LLM_MODEL=mistral-small:24b
LLM_TIMEOUT=300

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

CHROMA_PATH=data/chroma_db
UPLOAD_PATH=data/uploads

CHUNK_SIZE=1000
CHUNK_OVERLAP=200

DENSE_TOP_K=10
SPARSE_TOP_K=10
FUSION_TOP_K=10
RRF_K=60
RERANK_TOP_K=8

ENABLE_RERANKER=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

MAX_EPISODIC_EVENTS=20
CONTEXT_COMPACTION_ENABLED=true
CONTEXT_MAX_CHARACTERS=20000

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
