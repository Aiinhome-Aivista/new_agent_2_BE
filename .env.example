DENSE_TOP_K=10
SPARSE_TOP_K=10
FUSION_TOP_K=10
RRF_K=60
RERANK_TOP_K=8

ENABLE_RERANKER=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

MAX_EPISODIC_EVENTS=20
CONTEXT_COMPACTION_ENABLED=true
CONTEXT_MAX_CHARACTERS=20000

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=

# ── Google Drive Integration ──────────────────────────────────────────────────
# Scheduler interval — how often to poll Google Drive for new files.
# Examples:
#   Every 24 hours  → HOURS=24, MINUTES=0
#   Every 12 hours  → HOURS=12, MINUTES=0
#   Every 30 min    → HOURS=0,  MINUTES=30
DRIVE_SYNC_INTERVAL_HOURS=24
DRIVE_SYNC_INTERVAL_MINUTES=0

# Fernet symmetric encryption key — used to encrypt service-account credentials in DB.
# SECURITY: This key must be kept SECRET. Treat it like a database password.
# Generate once:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If left empty, credentials are stored as base64 (NOT encrypted — not safe for production).
DRIVE_CREDENTIAL_ENCRYPTION_KEY=
